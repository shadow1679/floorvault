# Container for the keeper (scripts/keeper.mjs): Node plus Foundry's `cast`, which does the signing.
#   railway up   (railway.json points at this file)
FROM ghcr.io/foundry-rs/foundry:stable AS foundry

FROM node:22-bookworm-slim
COPY --from=foundry /usr/local/bin/cast /usr/local/bin/cast
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY scripts ./scripts
RUN chmod +x scripts/keeper-entrypoint.sh
ENTRYPOINT ["scripts/keeper-entrypoint.sh"]
