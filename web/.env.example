# FloorVault web UI configuration. Monad mainnet (chain id 143) by default; set NEXT_PUBLIC_CHAIN_ID=10143 for testnet.
# Copy to .env.local and fill in the addresses logged by contracts/script/DeployTestnet.s.sol (or DeployMainnet.s.sol).
# NEXT_PUBLIC_* values are inlined at build time: restart `npm run dev` after editing.

# Network: 143 (Monad mainnet, Chog Genesis only, the default when blank) or 10143 (Monad testnet).
# NEXT_PUBLIC_CHAIN_ID=143

# FloorVault contract
NEXT_PUBLIC_FLOORVAULT_ADDRESS=
# Raffle contract (raffles each NFT the vault buys to the coin's holders)
NEXT_PUBLIC_RAFFLE_ADDRESS=
# Testnet only: MockMarketplace contract (source of floor prices and NFT purchases). Not used on mainnet.
NEXT_PUBLIC_MOCK_MARKETPLACE_ADDRESS=
# The featured collection. Testnet: the TestChog demo collection (the older name NEXT_PUBLIC_TEST_CHOG_ADDRESS still works).
# Mainnet: must be Chog Genesis, 0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763 (any other address is rejected).
NEXT_PUBLIC_COLLECTION_ADDRESS=
# NEXT_PUBLIC_TEST_CHOG_ADDRESS=
# Block where the first of Raffle / FloorVault was deployed (Raffle goes first). Event scans start here, in 100-block chunks.
# Decimal or 0x-hex. Find it in contracts/broadcast/<script>/<chain id>/run-latest.json (receipts[0].blockNumber, hex) or on the explorer.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional: override the RPC (defaults: https://testnet-rpc.monad.xyz, or https://rpc.monad.xyz on mainnet).
# Note: both public RPCs limit eth_getLogs to 100 blocks per request.
# NEXT_PUBLIC_RPC_URL=
# Optional: override nad.fun's API (defaults: https://dev-api.nadapp.net on testnet, https://api.nad.fun on mainnet).
# NEXT_PUBLIC_NADFUN_API_URL=

# ---- Server-side secrets (never prefix these with NEXT_PUBLIC_) ----------------------------------------------
# Mainnet only. OpenSea API key: the /api/floor route uses it for the floor price, and the keeper (npm run keeper)
# uses it to find and fulfill listings. Without it the floor shows "n/a" and the keeper cannot buy.
# OPENSEA_API_KEY=
# Mainnet keeper only: the SeaportAdapter contract that FloorVault.market() points to.
# SEAPORT_ADAPTER_ADDRESS=
# Optional: a log provider without the 100-block eth_getLogs cap, used by the server scan (/api/scan, /api/holders) and
# the keeper only, never by the browser. Envio reads the whole history in a few calls (token from app.envio.dev/api-tokens).
# The token's product decides the URL; a token made for one product is refused (403) by the other:
#   HyperSync  testnet https://monad-testnet.hypersync.xyz/<api-token>      mainnet https://monad.hypersync.xyz/<api-token>
#   HyperRPC   testnet https://monad-testnet.rpc.hypersync.xyz/<api-token>  mainnet https://monad.rpc.hypersync.xyz/<api-token>
# Any failure falls back to the public RPC. Use the URL for the chain NEXT_PUBLIC_CHAIN_ID selects.
# LOGS_RPC_URL=
